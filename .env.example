# Optional GitHub token for higher API limits. Public repositories work without it.
GITHUB_TOKEN=

# Optional Hugging Face token. Public Hub data works without it.
HF_TOKEN=

# Override the default local SQLite database location.
GENAI_INTEL_DB=data/genai_intelligence.sqlite3

# Hosted web service settings
GENAI_INTEL_CONFIG=config/sources.yaml
INGEST_INTERVAL_HOURS=24
INGEST_ON_STARTUP=true
ENABLE_INGESTION=true

# Hosted deployment: set DATABASE_URL to the pooled Postgres connection string.
# Set CRON_SECRET in Vercel project settings; never commit its real value.
DATABASE_URL=
CRON_SECRET=

# LLM study kits: the app tries Groq first, then Gemini on failure.
# Supply only free-tier API keys if you want to keep inference at zero cost.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides; defaults are configured in study.py.
GROQ_MODEL=
GEMINI_MODEL=
# Google Gemini embedding model used to index document chunks in pgvector.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
