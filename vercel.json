{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/index",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/edition",
      "schedule": "0 4 * * *"
    }
  ]
}
